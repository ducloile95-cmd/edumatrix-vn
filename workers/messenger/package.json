{
  "name": "edumatrix-messenger-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run",
    "build:prod": "npm run check:prod-config && node scripts/run-production.mjs --dry-run",
    "check:prod-config": "node scripts/check-production-config.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:prod": "npm run check:prod-config && node scripts/run-production.mjs",
    "test": "vitest run",
    "verify:prod": "npm run check:prod-config && node scripts/verify-production.mjs"
  },
  "dependencies": {
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "typescript": "^5.6.2",
    "vitest": "^3.2.6",
    "wrangler": "^4.114.0"
  },
  "overrides": {
    "undici": "7.29.0"
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edumatrix-messenger",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-11",
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "vars": {
    "FIREBASE_PROJECT_ID": "edumatrix-vn-576b1",
    "META_APP_ID": "1028280243271801",
    "META_GRAPH_VERSION": "v22.0",
    "ALLOWED_ORIGIN": "http://localhost:5173",
    "UTILITY_MESSAGING_ENABLED": "false"
  },
  "secrets": {
    "required": ["META_PAGE_ACCESS_TOKEN", "META_APP_SECRET", "META_WEBHOOK_VERIFY_TOKEN", "FIREBASE_CLIENT_EMAIL", "FIREBASE_PRIVATE_KEY"]
  },
  "env": {
    "production": {
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      },
      "vars": {
        "FIREBASE_PROJECT_ID": "edumatrix-vn-576b1",
        "META_APP_ID": "1028280243271801",
        "META_GRAPH_VERSION": "v22.0",
        "ALLOWED_ORIGIN": "https://edumatrix-vn-576b1.web.app,https://edumatrix.id.vn",
        "UTILITY_MESSAGING_ENABLED": "false"
      },
      "secrets": {
        "required": ["META_PAGE_ACCESS_TOKEN", "META_APP_SECRET", "META_WEBHOOK_VERIFY_TOKEN", "FIREBASE_CLIENT_EMAIL", "FIREBASE_PRIVATE_KEY"]
      }
    }
  }
}

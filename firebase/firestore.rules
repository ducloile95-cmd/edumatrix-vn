    function validAnnouncementTarget(announcementId, data) {
      return data.classId is string && data.studentId is string &&
        canManageClass(data.classId) &&
        data.studentId in get(/databases/$(database)/documents/classes/$(data.classId)).data.studentIds &&
        (
          (
            data.type == 'attendance_alert' &&

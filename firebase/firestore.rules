        data.amount is number && data.amount > 0 &&
        data.transactionReference is string &&
        data.note is string &&
        data.status in ['reported', 'verified', 'rejected'] &&
        data.reportedBy is string &&
        (data.verifiedBy == null || data.verifiedBy is string) &&
        data.reportedAt is timestamp &&
        (data.verifiedAt == null || data.verifiedAt is timestamp) &&
        data.updatedAt is timestamp &&
        existsAfter(/databases/$(database)/documents/students/$(data.studentId)) &&
        existsAfter(/databases/$(database)/documents/invoices/$(data.invoiceId)) &&
        getAfter(/databases/$(database)/documents/invoices/$(data.invoiceId)).data.studentId == data.studentId;
    }

    function validInvoiceData(data) {
      return data.keys().hasAll([
          'invoiceCode', 'studentId', 'courseId', 'title', 'amount', 'dueAt',
          'paymentContent', 'bankBin', 'accountNumber', 'accountName', 'status',
          'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'invoiceCode', 'studentId', 'courseId', 'title', 'amount', 'dueAt',
          'paymentContent', 'bankBin', 'accountNumber', 'accountName', 'status',
          'createdBy', 'createdAt', 'updatedAt', 'sourceType', 'sourceId', 'classId',
          'subjectId', 'billingItemId', 'itemNameSnapshot', 'unitPriceSnapshot', 'quantity'
        ]) &&
        data.invoiceCode is string && data.studentId is string &&
        (data.courseId == null || data.courseId is string) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 240 &&
        data.amount is int && data.amount > 0 && data.dueAt is timestamp &&
        data.paymentContent is string && data.bankBin is string &&
        data.accountNumber is string && data.accountName is string &&
        data.status in ['unpaid', 'pending', 'paid', 'overdue', 'rejected'] &&
        data.createdBy is string && hasTimestamps(data) &&
        existsAfter(/databases/$(database)/documents/students/$(data.studentId)) &&
        (data.courseId == null || exists(/databases/$(database)/documents/courses/$(data.courseId))) &&
        (
          !data.keys().hasAny(['sourceType']) ||
          (
            data.keys().hasAll(['sourceId', 'classId', 'subjectId', 'billingItemId', 'itemNameSnapshot', 'unitPriceSnapshot', 'quantity']) &&
            data.sourceType == 'class' && data.sourceId == data.classId &&
            data.classId is string && data.subjectId == null && data.billingItemId == null &&
            data.itemNameSnapshot is string && data.unitPriceSnapshot is int && data.unitPriceSnapshot > 0 &&
            data.quantity is int && data.quantity > 0 && data.amount == data.unitPriceSnapshot * data.quantity &&
            exists(/databases/$(database)/documents/classes/$(data.classId)) &&
            get(/databases/$(database)/documents/classes/$(data.classId)).data.courseId == data.courseId &&
            data.studentId in get(/databases/$(database)/documents/classes/$(data.classId)).data.studentIds
          ) ||
          (
            data.keys().hasAll(['sourceId', 'classId', 'subjectId', 'billingItemId', 'itemNameSnapshot', 'unitPriceSnapshot', 'quantity']) &&
            data.sourceType == 'billing_item' && data.sourceId == data.billingItemId &&
            data.classId is string && data.billingItemId is string && data.subjectId is string &&
            data.itemNameSnapshot is string && data.unitPriceSnapshot is int && data.unitPriceSnapshot > 0 &&
            data.quantity is int && data.quantity > 0 && data.amount == data.unitPriceSnapshot * data.quantity &&
            exists(/databases/$(database)/documents/billing_items/$(data.billingItemId)) &&
            get(/databases/$(database)/documents/billing_items/$(data.billingItemId)).data.status == 'active' &&
            get(/databases/$(database)/documents/billing_items/$(data.billingItemId)).data.courseId == data.courseId &&
            get(/databases/$(database)/documents/billing_items/$(data.billingItemId)).data.subjectId == data.subjectId &&
            get(/databases/$(database)/documents/billing_items/$(data.billingItemId)).data.unitPrice == data.unitPriceSnapshot &&
            exists(/databases/$(database)/documents/classes/$(data.classId)) &&
            get(/databases/$(database)/documents/classes/$(data.classId)).data.status == 'active' &&
            get(/databases/$(database)/documents/classes/$(data.classId)).data.courseId == data.courseId &&
            data.subjectId in get(/databases/$(database)/documents/classes/$(data.classId)).data.subjectIds &&
            data.studentId in get(/databases/$(database)/documents/classes/$(data.classId)).data.studentIds
          )
        );
    }

    // ---------- users/{uid} ----------
    // Chi Admin duoc doi role/studentIds/status. Tao ho so lan dau (claim invite)
    // phai khop dung role/studentIds lay tu invite - nguoi dung khong tu chon (A16.4).

    match /users/{uid} {
      allow read: if isStaff() || request.auth.uid == uid;

      allow create: if validUserData(request.resource.data) && (isAdmin() || (
        request.auth.uid == uid &&
        hasActiveInvite() &&
        request.resource.data.email == requesterEmail() &&
        request.resource.data.role == inviteForRequester().role &&
        request.resource.data.studentIds == inviteForRequester().studentIds &&
        request.resource.data.status == 'active' &&
        request.resource.data.keys().hasOnly(
          ['email', 'displayName', 'photoURL', 'role', 'studentIds', 'status', 'createdAt', 'updatedAt']
        )
      ));

      allow update: if validUserData(request.resource.data) && ((
        isAdmin() && keepsImmutable(['email', 'createdAt'])
      ) || (
        request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'photoURL', 'lastLoginAt', 'notificationPrefs', 'phone', 'address', 'facebookUrl', 'updatedAt']) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.studentIds == resource.data.studentIds &&
        request.resource.data.status == resource.data.status
      ));

      allow delete: if isAdmin() && request.auth.uid != uid && resource.data.role != 'admin';
    }

    // ---------- invites/{normalizedEmail} ----------
    // Chi Admin tao/sua/xoa loi moi. Nguoi duoc moi chi duoc doc loi moi cua
    // chinh email da xac thuc, va chi duoc cap nhat status active -> claimed
    // khi claim (khong duoc tu doi role/studentIds/email cua loi moi) (A16.4).

    match /invites/{email} {
      allow read: if isAdmin() || (
        hasVerifiedEmail() && requesterEmail() == email
      );

      allow create: if isAdmin() &&
        validInviteData(email, request.resource.data) &&
        request.resource.data.status == 'active';

      allow update: if validInviteData(email, request.resource.data) && (isAdmin() || (
        hasVerifiedEmail() &&
        requesterEmail() == email &&
        resource.data.status == 'active' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'claimedAt']) &&
        request.resource.data.status == 'claimed'
      ));

      allow delete: if isAdmin();
    }

    // ---------- link_requests/{parentUid} ----------
    // Duong vao thu hai ben canh invites/: phu huynh dang nhap Gmail lan dau, tu
    // khai bao con, roi cho Admin duyet. Doc id = uid nen moi Gmail chi co dung
    // mot yeu cau - submit hai lan khong de ra hai ban ghi.
    // Khong tu dong duyet bang Rules: du lieu tre em, giu mot buoc nguoi that kiem tra.

    match /link_requests/{uid} {
      allow read: if isStaff() || (signedIn() && request.auth.uid == uid);

      allow create: if hasVerifiedEmail() &&
        request.auth.uid == uid &&
        !userExists() &&
        request.resource.data.email == requesterEmail() &&
        request.resource.data.status == 'pending' &&
        request.resource.data.children is list &&
        request.resource.data.children.size() >= 1 &&
        request.resource.data.children.size() <= 5 &&
        request.resource.data.keys().hasAll(['email', 'parentName', 'phone', 'relationship', 'children', 'status', 'createdAt', 'updatedAt']) &&
        request.resource.data.keys().hasOnly([
          'email', 'parentName', 'phone', 'address', 'facebookUrl', 'relationship',
          'children', 'status', 'createdAt', 'updatedAt'
        ]);
        // ponytail: khong validate sau tung phan tu children - Rules khong lam gon duoc,
        // va Admin doc bang mat truoc khi duyet. Nang len neu sau nay tu dong duyet.

      allow update: if isAdmin() || (
        signedIn() &&
        request.auth.uid == uid &&
        resource.data.status != 'approved' &&
        request.resource.data.status == 'pending'
      );

      allow delete: if false;
    }

    // ---------- legacy client telemetry ----------
    // Existing records stay readable by Admin for migration/audit, but clients
    // can no longer create noisy self-reported telemetry.
    match /account_activity/{activityId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---------- settings/* ----------
    // Integration identifiers are public config for active staff. Other settings remain Admin-only.
    match /settings/{docId} {
      allow read: if isAdmin() ||
        (docId in ['integrations', 'payment'] && isStaff()) ||
        (docId == 'academic' && isActive());
      allow create: if isAdmin() && (
        (docId == 'general' && validGeneralSettings(request.resource.data)) ||
        (docId == 'academic' && validAcademicSettings(request.resource.data)) ||
        (docId == 'integrations' && validIntegrationSettings(request.resource.data) &&
          !request.resource.data.keys().hasAny(['messengerUtilityEnabledTemplates', 'messengerUtilityUpdatedAt'])) ||
        (docId == 'payment' && validPaymentSettings(request.resource.data)) ||
        (docId == 'messenger')
      );
      allow update: if isAdmin() && (
        (docId == 'general' && validGeneralSettings(request.resource.data)) ||
        (docId == 'academic' && validAcademicSettings(request.resource.data)) ||
        (docId == 'integrations' && validIntegrationSettings(request.resource.data) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['messengerUtilityEnabledTemplates', 'messengerUtilityUpdatedAt'])) ||
        (docId == 'payment' && validPaymentSettings(request.resource.data)) ||
        (docId == 'messenger')
      );
      allow delete: if false;
    }

    match /usage_events/{usageId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---------- audit_logs/{logId} ----------
    // Staff duoc ghi (khong duoc sua/xoa - bat bien), chi Admin duoc xem (A26).

    match /audit_logs/{logId} {
      allow read: if isAdmin();

      allow create: if isStaff() &&
        request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.keys().hasOnly(
          ['action', 'actorUid', 'actorEmail', 'targetType', 'targetId', 'meta', 'createdAt']
        );

      allow update, delete: if false;
    }

    // ---------- subjects/{subjectId} ----------
    // Admin CRUD. Danh muc mon hoc khong nhay cam theo tung hoc sinh nen moi nguoi dung active deu
    // doc duoc (Phase 3, phuc vu Portal Phase 10 ve sau).

    match /subjects/{subjectId} {
      allow read: if isActive();
      allow create: if isAdmin() &&
        request.resource.data.status == 'active' &&
        validSubjectData(subjectId, request.resource.data);
      allow update: if isAdmin() &&
        validSubjectData(subjectId, request.resource.data) &&
        keepsImmutable(['code', 'createdAt']);
      allow delete: if isAdmin();
    }

    // ---------- courses/{courseId} ----------
    // Admin quan ly danh muc khoa hoc. Teacher duoc gan chi co the cap nhat
    // con tro giao trinh trong giao dich publish; moi tai khoan active duoc doc.

    match /courses/{courseId} {
      allow read: if isActive();
      allow create: if isAdmin() &&
        request.resource.data.keys().hasAny(['teacherIds']) &&
        request.resource.data.teacherIds.size() > 0 &&
        request.resource.data.totalSessions <= 200 &&
        validCourseData(courseId, request.resource.data);
      allow update: if (isAdmin() || isTeacherCurriculumPointerUpdate(courseId)) &&
        validCourseData(courseId, request.resource.data) &&
        validCourseClassRevisionUpdate() &&
        (request.resource.data.totalSessions <= 200 || request.resource.data.totalSessions == resource.data.totalSessions) &&
        keepsImmutable(['createdAt']);
      allow delete: if isAdmin();
    }

    // ---------- billing_items/{billingItemId} ----------
    // Do dung hoc tap la danh muc tai chinh. Moi tai khoan active duoc doc de
    // hien thi ten khoan thu, chi Admin duoc quan ly.

    match /billing_items/{billingItemId} {
      allow read: if isActive();
      allow create: if isAdmin() &&
        request.resource.data.status == 'active' &&
        validBillingItemData(request.resource.data);
      allow update: if isAdmin() &&
        validBillingItemData(request.resource.data) &&
        keepsImmutable(['createdAt']);
      allow delete: if false;
    }

    // ---------- students/{studentId} ----------
    // Staff CRUD. Viewer chi doc duoc ho so hoc sinh minh so huu qua
    // ownsStudent() (A11 - quy tac ownership, khong dua tren du lieu Viewer
    // tu sua duoc).

    match /students/{studentId} {
      allow read: if isStaff() || (
        isTeacher() && request.auth.uid in resource.data.teacherIds
      ) || ownsStudent(studentId);
      allow create: if (
        isAdmin() ||
        (
          isTeacher() &&
          request.resource.data.parentUids.size() == 0 &&
          request.resource.data.currentClassIds.size() == 1 &&
          request.auth.uid in get(/databases/$(database)/documents/classes/$(request.resource.data.currentClassIds[0])).data.teacherIds &&
          get(/databases/$(database)/documents/classes/$(request.resource.data.currentClassIds[0])).data.status == 'active' &&
          request.resource.data.teacherIds == get(/databases/$(database)/documents/classes/$(request.resource.data.currentClassIds[0])).data.teacherIds &&
          request.resource.data.status == 'active'
        )
      ) && validStudentData(studentId, request.resource.data);
      allow update: if keepsImmutable(['studentCode', 'createdAt']) &&
        validStudentData(studentId, request.resource.data) &&
        (
          isAdmin() || (
            request.resource.data.diff(resource.data).affectedKeys().hasAny(['currentClassIds', 'teacherIds']) &&
            (isTeacherEnrollmentStudentUpdate() || isTeacherUnenrollmentStudentUpdate())
          ) || (
          isTeacher() &&
            request.auth.uid in resource.data.teacherIds &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['fullName', 'nickname', 'dateOfBirth', 'staffNote', 'updatedAt']) &&
            request.resource.data.teacherIds == resource.data.teacherIds &&
            request.resource.data.currentClassIds == resource.data.currentClassIds &&
            request.resource.data.parentUids == resource.data.parentUids
          )
        );
      allow delete: if isAdmin();
    }

    // ---------- classes/{classId} ----------
    // Staff CRUD. Viewer chi doc lop co studentIds giao voi studentIds cua
    // minh (A11). Ghi danh (them/bot studentIds) chi thuc hien qua
    // enrollments/{classId_studentId} de dong bo hai chieu voi
    // students/{id}.currentClassIds (xem services/firestore/enrollments.ts).

    match /classes/{classId} {
      // Use resource data here so Firestore can prove an array-contains list
      // query. isAssignedTeacherForClass() uses get() and is for child records.
      allow read: if isStaff() ||
        (isTeacher() && request.auth.uid in resource.data.teacherIds) ||
        (isActive() && currentUser().role == 'viewer' &&
         resource.data.studentIds.hasAny(currentUser().studentIds));
      allow create: if (
        isAdmin() ||
        (
          isTeacher() &&
          isAssignedTeacherForCourse(request.resource.data.courseId) &&
          request.resource.data.subjectIds.hasOnly(
            get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.subjectIds
          ) &&
          request.resource.data.teacherIds.size() == 1 &&
          request.resource.data.teacherIds[0] == request.auth.uid &&
          request.resource.data.studentIds.size() == 0
        )
      ) &&
        validClassData(request.resource.data) &&
        advancesCourseClassRevision(request.resource.data.courseId) &&
        exists(/databases/$(database)/documents/courses/$(request.resource.data.courseId)) &&
        get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.status == 'active' &&
        request.resource.data.subjectIds.hasOnly(get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.subjectIds) &&
        request.resource.data.teacherIds.hasOnly(get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.teacherIds) &&
        (!request.resource.data.keys().hasAny(['recurrence']) || request.resource.data.recurrence == null ||
          request.resource.data.recurrence.sessionCount == get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.totalSessions);
      allow update: if keepsImmutable(['createdAt', 'courseId', 'curriculumId', 'curriculumVersion']) &&
        validClassData(request.resource.data) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'subjectIds', 'teacherIds', 'recurrence']) ||
          advancesCourseClassRevision(resource.data.courseId)) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['subjectIds', 'teacherIds', 'recurrence']) || (
            request.resource.data.subjectIds.hasOnly(
              get(/databases/$(database)/documents/courses/$(resource.data.courseId)).data.subjectIds
            ) &&
            request.resource.data.teacherIds.hasOnly(
              get(/databases/$(database)/documents/courses/$(resource.data.courseId)).data.teacherIds
            ) &&
            (!request.resource.data.keys().hasAny(['recurrence']) || request.resource.data.recurrence == null ||
              request.resource.data.recurrence.sessionCount == get(/databases/$(database)/documents/courses/$(resource.data.courseId)).data.totalSessions)
          )
        ) &&
        (
          isAdmin() ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasAny(['studentIds']) &&
            (isTeacherEnrollmentClassUpdate() || isTeacherUnenrollmentClassUpdate())
          ) ||
          (
            isAssignedTeacherForClass(classId) &&
            request.resource.data.courseId == resource.data.courseId &&
            isAssignedTeacherForCourse(resource.data.courseId) &&
            request.resource.data.subjectIds.hasOnly(
              get(/databases/$(database)/documents/courses/$(resource.data.courseId)).data.subjectIds
            ) &&
            request.resource.data.teacherIds == resource.data.teacherIds &&
            request.resource.data.studentIds == resource.data.studentIds &&
            request.resource.data.status != 'cancelled'
          )
        );
      allow delete: if isAdmin();
    }

    // ---------- enrollments/{classId_studentId} ----------
    // ID xac dinh {classId}_{studentId} chong ghi trung (A13). Staff CRUD;
    // Viewer chi doc ghi danh cua hoc sinh minh so huu.

    match /enrollments/{enrollmentId} {
      allow read: if isStaff() || ownsStudent(resource.data.studentId);
      allow create: if validEnrollmentData(enrollmentId, request.resource.data) &&
        request.resource.data.version == 1 && request.resource.data.updatedAt == request.time && ((
        isAdmin() &&
        request.resource.data.status in ['active', 'ended']
      ) || isTeacherEnrollmentCreate(enrollmentId));
      allow update: if (
        isAdmin() ||
        (
          isAssignedTeacherForClass(resource.data.classId) &&
          resource.data.status == 'active' &&
          request.resource.data.status == 'ended'
        )
      ) &&
        validEnrollmentData(enrollmentId, request.resource.data) &&
        keepsImmutable(['classId', 'courseId', 'studentId', 'joinedAt']) &&
        request.resource.data.updatedAt == request.time &&
        (
          (resource.data.status == 'ended' && request.resource.data.status == 'active' &&
            request.resource.data.version == resource.data.get('version', 0) + 1) ||
          (resource.data.status == 'active' && request.resource.data.status == 'ended' &&
            request.resource.data.version == resource.data.get('version', 1))
        );
      allow delete: if isAdmin();
    }

    match /sessions/{sessionId} {
      allow read: if isStaff() || (
        isActive() && currentUser().role == 'viewer' &&
        get(/databases/$(database)/documents/classes/$(resource.data.classId)).data.studentIds
          .hasAny(currentUser().studentIds)
      );
      allow create: if canManageClass(request.resource.data.classId) &&
        classIsSchedulable(request.resource.data.classId) &&
        validSessionData(request.resource.data);
      allow update: if canManageClass(resource.data.classId) &&
        validSessionData(request.resource.data) &&
        keepsImmutable(['classId', 'sequenceNumber', 'curriculumVersion', 'curriculumItemId', 'createdAt']) &&
        (
          request.resource.data.get('scheduleVersion', 0) == resource.data.get('scheduleVersion', 0) ||
          (
            request.resource.data.get('scheduleVersion', 0) == resource.data.get('scheduleVersion', 0) + 1 &&
            (
              (request.resource.data.status == 'cancelled' && resource.data.status != 'cancelled') ||
              (request.resource.data.status == 'rescheduled' && (
                request.resource.data.startAt != resource.data.startAt || request.resource.data.endAt != resource.data.endAt
              ))
            )
          )
        ) &&
        (
          classIsSchedulable(resource.data.classId) ||
          (
            request.resource.data.status == 'cancelled' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'note', 'scheduleVersion', 'updatedAt'])
          )
        );
      allow delete: if false;
    }

    match /session_interactions/{sessionId} {
      allow get: if isStaff() || (sessionBelongsToClass(
          sessionId,
          get(/databases/$(database)/documents/sessions/$(sessionId)).data.classId
        ) && canManageClass(get(/databases/$(database)/documents/sessions/$(sessionId)).data.classId));
      allow list: if isStaff();
      allow create: if canManageClass(request.resource.data.classId) &&
        validSessionInteraction(request.resource.data, sessionId);
      allow update: if canManageClass(resource.data.classId) && (
        (
          validSessionInteraction(request.resource.data, sessionId) &&
          keepsImmutable(['sessionId', 'classId', 'courseId', 'teacherId', 'workflowStatus', 'version', 'createdAt'])
        ) || (
          // Phat hanh: draft/amended -> published, version tang dung 1, khong doi noi dung.
          resource.data.workflowStatus in ['draft', 'amended'] &&
          request.resource.data.workflowStatus == 'published' &&
          request.resource.data.version == resource.data.version + 1 &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['workflowStatus', 'version', 'updatedAt']) &&
          request.resource.data.updatedAt is timestamp
        ) || (
          // Mo lai de dinh chinh: published -> amended, chi doi trang thai.
          resource.data.workflowStatus == 'published' &&
          request.resource.data.workflowStatus == 'amended' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['workflowStatus', 'updatedAt']) &&
          request.resource.data.updatedAt is timestamp
        ) || (
          // Sua noi dung khi dang dinh chinh (version > 1 nen khong qua validSessionInteraction).
          resource.data.workflowStatus == 'amended' &&
          request.resource.data.workflowStatus == 'amended' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['taughtContent', 'quickSummary', 'homeworkText', 'updatedAt']) &&
          request.resource.data.taughtContent is string && request.resource.data.taughtContent.size() <= 2000 &&
          request.resource.data.quickSummary is string && request.resource.data.quickSummary.size() <= 2000 &&
          request.resource.data.homeworkText is string && request.resource.data.homeworkText.size() <= 2000 &&
          request.resource.data.updatedAt is timestamp
        )
      );
      allow delete: if false;
    }

    match /session_student_reviews/{reviewId} {
      allow read: if isStaff();
      allow create: if canManageClass(request.resource.data.classId) &&
        validSessionStudentReview(request.resource.data, reviewId);
      allow update: if canManageClass(resource.data.classId) &&
        validSessionStudentReview(request.resource.data, reviewId) &&
        keepsImmutable(['sessionId', 'classId', 'studentId']);
      allow delete: if false;
    }

    match /announcements/{announcementId} {
      allow read: if isStaff() || (
        isActive() && resource.data.studentId != null && ownsStudent(resource.data.studentId)
      );
      allow create: if isStaff() && validAnnouncementData(request.resource.data) &&
        validAnnouncementTarget(announcementId, request.resource.data);
      allow update: if isStaff() &&
        validAnnouncementData(request.resource.data) &&
        canManageClass(resource.data.classId) &&
        (
          (
            resource.data.type == 'attendance_alert' &&
            announcementId == 'attendance_' + resource.data.sessionId + '_' + resource.data.studentId
          ) || (
            // schedule_change: moi lan doi lich cap nhat lai cung doc ID de phu huynh thay noi dung moi nhat.
            resource.data.type == 'schedule_change' &&
            announcementId == 'schedule_' + resource.data.sessionId + '_' + resource.data.studentId
          ) || (
            // session_summary: phat hanh lai (dinh chinh) ghi de cung doc ID {sessionId}_{studentId}.
            resource.data.type == 'session_summary' &&
            announcementId == resource.data.sessionId + '_' + resource.data.studentId
          )
        ) &&
        keepsImmutable(['type', 'sessionId', 'classId', 'studentId']) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'message', 'createdAt', 'resolvedAt']);
      allow delete: if false;
    }

    match /notification_reads/{readId} {
      allow read: if isAdmin() || (
        isActive() && resource.data.uid == request.auth.uid
      );
      allow create, update: if isActive() &&
        request.resource.data.keys().hasOnly(['uid', 'announcementId', 'readAt', 'dismissedAt']) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.announcementId is string &&
        request.resource.data.readAt is timestamp &&
        (!request.resource.data.keys().hasAny(['dismissedAt']) || request.resource.data.dismissedAt is timestamp) &&
        readId == request.auth.uid + '_' + request.resource.data.announcementId &&
        ownsStudent(
          get(/databases/$(database)/documents/announcements/$(request.resource.data.announcementId)).data.studentId
        );
      allow delete: if false;
    }

    match /lesson_plans/{lessonPlanId} {
      // Nguoi tao luon doc lai duoc giao an cua chinh minh, ke ca khi chua gan lop (classId == null) - sua loi cu.
      allow read: if isStaff() ||
        (resource.data.classId != null && isAssignedTeacherForClass(resource.data.classId)) ||
        resource.data.createdBy == request.auth.uid;
      allow create: if (isAdmin() || (request.resource.data.classId != null && isAssignedTeacherForClass(request.resource.data.classId))) &&
        request.resource.data.createdBy == request.auth.uid &&
        validLessonPlanData(request.resource.data) &&
        lessonPlanLinksBelongTogether(request.resource.data);
      allow update: if (isAdmin() || (resource.data.classId != null && isAssignedTeacherForClass(resource.data.classId))) &&
        validLessonPlanData(request.resource.data) &&
        lessonPlanLinksBelongTogether(request.resource.data) &&
        keepsImmutable(['classId', 'createdBy', 'createdAt']);
      allow delete: if false;
    }

    match /lesson_plan_public/{lessonPlanId} {
      allow read: if isStaff() || (
        isActive() && currentUser().role == 'viewer' &&
        get(/databases/$(database)/documents/classes/$(resource.data.classId)).data.studentIds
          .hasAny(currentUser().studentIds)
      );
      allow create: if canManageClass(request.resource.data.classId) && validLessonPlanPublicData(request.resource.data, lessonPlanId);
      allow update: if canManageClass(resource.data.classId) &&
        validLessonPlanPublicData(request.resource.data, lessonPlanId) &&
        keepsImmutable(['lessonPlanId', 'classId']);
      allow delete: if canManageClass(resource.data.classId);
    }

    match /lesson_plan_templates/{templateId} {
      allow read: if isStaff();
      allow create: if isStaff() && validLessonPlanTemplateData(request.resource.data);
      allow update: if isStaff() && validLessonPlanTemplateData(request.resource.data) && keepsImmutable(['createdAt']);
      allow delete: if false;
    }

    match /standard_lessons/{lessonId} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.approvalStatus == 'draft' && request.resource.data.revision == 1 &&
        validStandardLessonData(request.resource.data);
      allow update: if isStaff() && validStandardLessonData(request.resource.data) &&
        validStandardLessonTransition() && keepsImmutable(['createdBy', 'createdAt']);
      allow delete: if false;
    }

    match /course_curricula/{curriculumId} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.status == 'draft' &&
        request.resource.data.publishedBy == null && request.resource.data.publishedAt == null &&
        validCourseCurriculumData(curriculumId, request.resource.data) &&
        validCurriculumCourseState(curriculumId, request.resource.data);
      allow update: if isStaff() && validCourseCurriculumData(curriculumId, request.resource.data) &&
        validCurriculumTransition() && validCurriculumCourseState(curriculumId, request.resource.data) &&
        keepsImmutable(['courseId', 'version', 'createdAt']);
      allow delete: if false;
    }

    match /course_curriculum_items/{itemId} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.status == 'draft' &&
        validCourseCurriculumItemData(itemId, request.resource.data) && validCurriculumStandardLesson(request.resource.data) &&
        curriculumItemVersionIsEditable(request.resource.data);
      allow update: if isStaff() && validCourseCurriculumItemData(itemId, request.resource.data) &&
        validCurriculumStandardLesson(request.resource.data) &&
        curriculumItemVersionIsEditable(request.resource.data) &&
        keepsImmutable(['courseId', 'curriculumVersion', 'sequenceNumber', 'createdAt']);
      allow delete: if false;
    }

    match /attendance/{attendanceId} {
      allow read: if isStaff() || ownsStudent(resource.data.studentId);
      allow create: if canManageClass(request.resource.data.classId) &&
        validAttendanceData(request.resource.data, attendanceId) &&
        request.resource.data.studentId in
          get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.studentIds;
      allow update: if canManageClass(resource.data.classId) &&
        validAttendanceData(request.resource.data, attendanceId) &&
        keepsImmutable(['sessionId', 'classId', 'studentId']);
      allow delete: if false;
    }

    match /attendance_summaries/{sessionId} {
      allow read: if isStaff() || (
        isActive() && currentUser().role == 'viewer' &&
        get(/databases/$(database)/documents/classes/$(resource.data.classId)).data.studentIds
          .hasAny(currentUser().studentIds)
      );
      allow create: if canManageClass(request.resource.data.classId) &&
        request.resource.data.sessionId == sessionId &&
        sessionBelongsToClass(sessionId, request.resource.data.classId) &&
        validAttendanceSummary(request.resource.data);
      allow update: if canManageClass(resource.data.classId) &&
        request.resource.data.sessionId == sessionId &&
        sessionBelongsToClass(sessionId, request.resource.data.classId) &&
        validAttendanceSummary(request.resource.data) &&
        keepsImmutable(['sessionId', 'classId']);
      allow delete: if false;
    }

    match /assignments/{assignmentId} {
      allow read: if isStaff() || (
        isActive() && currentUser().role == 'viewer' && resource.data.status == 'published' &&
        get(/databases/$(database)/documents/classes/$(resource.data.classId)).data.studentIds.hasAny(currentUser().studentIds)
      );
      allow create: if canManageClass(request.resource.data.classId) &&
        request.resource.data.createdBy == request.auth.uid &&
        validAssignmentData(request.resource.data) &&
        assignmentLinksBelongToClass(request.resource.data);
      allow update: if canManageClass(resource.data.classId) &&
        validAssignmentData(request.resource.data) &&
        assignmentLinksBelongToClass(request.resource.data) &&
        keepsImmutable(['classId', 'createdBy', 'createdAt']);
      allow delete: if false;
    }
    match /submissions/{submissionId} {
      allow read: if isStaff() || ownsStudent(resource.data.studentId);
      allow create: if ownsStudent(request.resource.data.studentId) &&
        submissionId == request.resource.data.assignmentId + '_' + request.resource.data.studentId &&
        request.resource.data.status == 'submitted' && request.resource.data.score == null && request.resource.data.teacherComment == '' &&
        validSubmissionData(request.resource.data) &&
        get(/databases/$(database)/documents/assignments/$(request.resource.data.assignmentId)).data.classId == request.resource.data.classId &&
        get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.studentIds.hasAny([request.resource.data.studentId]);
      allow update: if keepsImmutable(['assignmentId', 'studentId', 'classId']) &&
        validSubmissionData(request.resource.data) &&
        (
          (
            canManageClass(resource.data.classId) &&
            request.resource.data.status in ['submitted', 'reviewing', 'graded', 'redo_required'] &&
            request.resource.data.checkedBy == request.auth.uid &&
            (
              request.resource.data.score == null ||
              (
                request.resource.data.score >= 0 &&
                request.resource.data.score <= get(/databases/$(database)/documents/assignments/$(resource.data.assignmentId)).data.maxScore
              )
            )
          ) || (
            ownsStudent(resource.data.studentId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['submissionUrl', 'submissionText', 'studentNote', 'status', 'submittedAt', 'updatedAt']) &&
            request.resource.data.status == 'submitted'
          )
        );
      allow delete: if false;
    }
    match /assignment_summaries/{assignmentId} {
      allow read: if isAdmin() || (
        isTeacher() && canManageClass(
          get(/databases/$(database)/documents/assignments/$(assignmentId)).data.classId
        )
      );
      allow create: if request.resource.data.assignmentId == assignmentId &&
        canManageClass(
          getAfter(/databases/$(database)/documents/assignments/$(assignmentId)).data.classId
        ) &&
        validAssignmentSummary(request.resource.data);
      allow update: if canManageClass(
          get(/databases/$(database)/documents/assignments/$(assignmentId)).data.classId
        ) &&
        request.resource.data.assignmentId == assignmentId &&
        validAssignmentSummary(request.resource.data) &&
        keepsImmutable(['assignmentId']);
      allow delete: if false;
    }
    match /scores/{scoreId} {
      allow read: if isStaff() ||
        (ownsStudent(resource.data.studentId) && resource.data.get('published', true));
      allow create: if canManageClass(request.resource.data.classId) &&
        request.resource.data.maxScore > 0 &&
        request.resource.data.score >= 0 && request.resource.data.score <= request.resource.data.maxScore &&
        request.resource.data.subjectId in get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.subjectIds &&
        (
          request.resource.data.get('source', 'manual') == 'assignment' ||
          request.resource.data.studentId in
            get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.studentIds
        ) &&
        validScoreSource(request.resource.data, scoreId);
      allow update: if canManageClass(resource.data.classId) &&
        request.resource.data.maxScore > 0 &&
        request.resource.data.score >= 0 && request.resource.data.score <= request.resource.data.maxScore &&
        request.resource.data.subjectId in get(/databases/$(database)/documents/classes/$(resource.data.classId)).data.subjectIds &&
        validScoreSource(request.resource.data, scoreId) &&
        request.resource.data.get('source', 'manual') == resource.data.get('source', 'manual') &&
        request.resource.data.get('assignmentId', null) == resource.data.get('assignmentId', null) &&
        request.resource.data.get('submissionId', null) == resource.data.get('submissionId', null) &&
        keepsImmutable(['studentId', 'classId', 'subjectId', 'assessmentName', 'assessmentType', 'createdBy', 'createdAt']);
      allow delete: if false;
    }
    match /student_summaries/{studentId} {
      allow read: if isStaff() || ownsStudent(studentId);
      allow create: if (isAdmin() || isAssignedTeacherForStudent(studentId)) && request.resource.data.studentId == studentId &&
        validStudentSummary(request.resource.data);
      allow update: if (isAdmin() || isAssignedTeacherForStudent(studentId)) &&
        request.resource.data.studentId == studentId &&
        validStudentSummary(request.resource.data) &&
        keepsImmutable(['studentId']);
      allow delete: if false;
    }
    match /invoices/{invoiceId} {
      allow read: if isStaff() || ownsStudent(resource.data.studentId);
      allow create: if (isAdmin() || (
          isTeacher() && request.resource.data.classId is string &&
          isAssignedTeacherForClass(request.resource.data.classId)
        )) &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.status == 'unpaid' &&
        validInvoiceData(request.resource.data);
      allow update: if keepsImmutable(
        ['invoiceCode', 'studentId', 'courseId', 'amount', 'paymentContent', 'bankBin', 'accountNumber', 'accountName', 'createdBy', 'createdAt', 'sourceType', 'sourceId', 'classId', 'subjectId', 'billingItemId', 'itemNameSnapshot', 'unitPriceSnapshot', 'quantity']
      ) && validInvoiceData(request.resource.data) && (
        isAdmin() || (
          isAssignedTeacherForStudent(resource.data.studentId) &&
          resource.data.status == 'pending' &&
          request.resource.data.status in ['paid', 'rejected'] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        ) || (
          ownsStudent(resource.data.studentId) && resource.data.status in ['unpaid', 'overdue', 'rejected'] &&
          request.resource.data.status == 'pending' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        )
      );
      allow delete: if false;
    }
    match /payments/{paymentId} {
      allow read: if isStaff() || ownsStudent(resource.data.studentId);
      allow create: if ownsStudent(request.resource.data.studentId) &&
        request.resource.data.status == 'reported' &&
        request.resource.data.reportedBy == request.auth.uid &&
        request.resource.data.verifiedBy == null &&
        validPaymentData(request.resource.data) &&
        getAfter(/databases/$(database)/documents/invoices/$(request.resource.data.invoiceId)).data.status == 'pending' &&
        getAfter(/databases/$(database)/documents/invoices/$(request.resource.data.invoiceId)).data.amount == request.resource.data.amount &&
        getAfter(/databases/$(database)/documents/invoices/$(request.resource.data.invoiceId)).data.studentId == request.resource.data.studentId;
      allow update: if validPaymentData(request.resource.data) && (((isAdmin() || isAssignedTeacherForStudent(resource.data.studentId)) &&
        resource.data.status == 'reported' &&
        request.resource.data.status in ['verified', 'rejected'] &&
        request.resource.data.verifiedBy == request.auth.uid &&
        getAfter(/databases/$(database)/documents/invoices/$(resource.data.invoiceId)).data.status ==
          (request.resource.data.status == 'verified' ? 'paid' : 'rejected') &&
        keepsImmutable(['invoiceId', 'studentId', 'amount', 'reportedBy', 'reportedAt'])
      ) || (
        ownsStudent(resource.data.studentId) &&
        resource.data.status == 'rejected' &&
        resource.data.reportedBy == request.auth.uid &&
        request.resource.data.status == 'reported' &&
        request.resource.data.reportedBy == request.auth.uid &&
        request.resource.data.invoiceId == resource.data.invoiceId &&
        request.resource.data.studentId == resource.data.studentId &&
        request.resource.data.amount == resource.data.amount &&
        request.resource.data.verifiedBy == null &&
        request.resource.data.verifiedAt == null &&
        getAfter(/databases/$(database)/documents/invoices/$(request.resource.data.invoiceId)).data.status == 'pending' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['transactionReference', 'note', 'status', 'verifiedBy', 'verifiedAt', 'reportedAt', 'updatedAt']
        )
      ));
      allow delete: if false;
    }
    match /chat_tags/{tagId} {
      allow read: if isStaff();
      allow create: if isAdmin() &&
        request.resource.data.keys().hasOnly(['label', 'color', 'createdBy', 'createdAt', 'updatedAt']) &&
        request.resource.data.label is string &&
        request.resource.data.label.size() > 0 && request.resource.data.label.size() <= 24 &&
        request.resource.data.color in ['red', 'pink', 'amber', 'green', 'blue'] &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /chat_threads/{threadId} {
      allow read: if isStaff() || (
        isTeacher() && request.auth.uid in resource.data.assignedTeacherIds &&
        request.auth.uid in get(/databases/$(database)/documents/students/$(resource.data.studentId)).data.teacherIds
      );
      allow update: if (isAdmin() || (
          isTeacher() && request.auth.uid in resource.data.assignedTeacherIds &&
          request.auth.uid in get(/databases/$(database)/documents/students/$(resource.data.studentId)).data.teacherIds
        )) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tagIds', 'unreadStaffCount', 'updatedAt']) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['tagIds']) || (
          request.resource.data.tagIds is list &&
          request.resource.data.tagIds.size() <= 10
        )) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['unreadStaffCount']) ||
          request.resource.data.unreadStaffCount == 0) &&
        request.resource.data.updatedAt == request.time;
      allow create, delete: if false;

      match /messages/{messageId} {
        allow read: if isAdmin() || (
          isTeacher() && request.auth.uid in
            get(/databases/$(database)/documents/chat_threads/$(threadId)).data.assignedTeacherIds &&
          request.auth.uid in get(/databases/$(database)/documents/students/$(
            get(/databases/$(database)/documents/chat_threads/$(threadId)).data.studentId
          )).data.teacherIds
        );
        allow create, update, delete: if false;
      }
    }

    match /messenger_connections/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if false;
    }

    // Nonce va reverse-index chi Worker voi service account duoc truy cap.
    match /messenger_link_nonces/{nonceId} {
      allow read, write: if false;
    }

    match /messenger_psid_links/{psid} {
      allow read, write: if false;
    }

    match /messenger_conversation_tombstones/{threadId} {
      allow read, write: if false;
    }

    match /messenger_delivery_jobs/{jobId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Event intent duoc ghi bat bien trong cung transaction nghiep vu. Worker
    // xac minh lan nua va fan-out thanh delivery jobs server-only.
    match /messenger_delivery_events/{eventId} {
      allow read: if isStaff();
      allow update, delete: if false;
      allow create: if isStaff() && validMessengerDeliveryEvent(eventId, request.resource.data);
    }

    match /viewer_dashboard/{parentUid} {
      allow read: if isActive() && request.auth.uid == parentUid && currentUser().role == 'viewer';
      allow write: if false;
    }

    // OAuth state và Page token đã mã hóa chỉ Worker service account được truy cập.
    match /messenger_oauth_states/{stateId} {
      allow read, write: if false;
    }

    match /messenger_private_config/{configId} {
      allow read, write: if false;
    }

    // Trạng thái duyệt Utility Template do Worker ghi qua service account
    // (bỏ qua Rules). Admin cần đọc được để dựng màn hình xem/bật/tắt template
    // ở Giai đoạn 6; client không bao giờ được ghi.
    match /messenger_template_status/{templateId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---------- Mac dinh: tu choi tat ca ----------
    // Cac collection khac (sessions, lesson_plans, attendance, assignments,
    // submissions, scores, invoices, payments, announcements...) se duoc mo
    // dan theo Phase 4-11, kem Emulator test cho tung quyen truoc khi
    // enable (A28).

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

        data.classId is string &&
        (!data.keys().hasAny(['subjectId']) || data.subjectId is string) &&
        (data.lessonPlanId == null || data.lessonPlanId is string) &&
        (data.sessionId == null || data.sessionId is string) &&
        data.dueAt is timestamp &&
        data.submissionType in ['link', 'text'] &&
        data.maxScore is number && data.maxScore > 0 &&
        data.status in ['draft', 'published', 'closed'] &&
        data.createdBy is string &&
        hasTimestamps(data);
    }

    function assignmentLinksBelongToClass(data) {
      return (
          !data.keys().hasAny(['subjectId']) ||
          data.subjectId in get(/databases/$(database)/documents/classes/$(data.classId)).data.subjectIds
        ) &&
        (
          data.lessonPlanId == null ||
          get(/databases/$(database)/documents/lesson_plans/$(data.lessonPlanId)).data.classId == data.classId
        ) &&
        (data.sessionId == null || sessionBelongsToClass(data.sessionId, data.classId));

rules_version = '2';

// EDUMATRIX-VN - Firestore Security Rules
// Nguyen tac: deny-by-default (A16.1). Day la lop bao mat chinh, khong duoc
// thay the boi UI/route guard (A4.3, A16). Rules nay se duoc mo rong dan
// theo tung Phase (A5, A30) - hien tai (Phase 1/2) chi mo users/invites.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helper functions ----------

    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userExists() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isActive() {
      return userExists() && currentUser().status == 'active';
    }

    function isAdmin() {
      return isActive() && currentUser().role == 'admin';
    }

    function isTeacher() {
      return isActive() && currentUser().role == 'teacher';
    }

    function isStaff() {
      return isAdmin() || isTeacher();
    }

    function validGeneralSettings(data) {
      return data.keys().hasOnly(['name', 'schoolYear', 'address', 'phone', 'logoUrl', 'updatedAt']) &&
        data.keys().hasAll(['name', 'schoolYear', 'address', 'phone', 'logoUrl', 'updatedAt']) &&
        data.name is string && data.name.size() <= 120 &&
        data.schoolYear is string && data.schoolYear.size() <= 30 &&
        data.address is string && data.address.size() <= 300 &&
        data.phone is string && data.phone.size() <= 30 &&
        data.logoUrl is string && data.logoUrl.size() <= 500;
    }

    function validIntegrationSettings(data) {
      return data.keys().hasOnly([
          'facebookPageId', 'facebookPageName', 'facebookPagePictureUrl',
          'facebookConnectionStatus', 'facebookUtilityMessagingPermission',
          'facebookWebhookSubscriptionStatus', 'facebookWebhookSubscribedFields',
          'facebookWebhookVerifiedAt', 'facebookConnectedAt',
          'messengerUtilityEnabledTemplates', 'messengerUtilityUpdatedAt',
          'driveFolderId', 'webhookUrl', 'updatedAt'
        ]) &&
        data.keys().hasAll(['facebookPageId', 'driveFolderId', 'webhookUrl', 'updatedAt']) &&
        data.facebookPageId is string && data.facebookPageId.size() <= 100 &&
        (!('facebookPageName' in data) || (data.facebookPageName is string && data.facebookPageName.size() <= 120)) &&
        (!('facebookPagePictureUrl' in data) || data.facebookPagePictureUrl == null || (
          data.facebookPagePictureUrl is string &&
          data.facebookPagePictureUrl.size() <= 2048 &&
          data.facebookPagePictureUrl.matches('https://.+')
        )) &&
        (!('facebookConnectionStatus' in data) || data.facebookConnectionStatus in ['connected', 'disconnected']) &&
        (!('facebookUtilityMessagingPermission' in data) || data.facebookUtilityMessagingPermission in ['granted', 'missing', 'unknown']) &&
        (!('facebookWebhookSubscriptionStatus' in data) || data.facebookWebhookSubscriptionStatus in ['verified', 'unknown']) &&
        (!('facebookWebhookSubscribedFields' in data) || (data.facebookWebhookSubscribedFields is list && data.facebookWebhookSubscribedFields.size() <= 10)) &&
        (!('facebookWebhookVerifiedAt' in data) || data.facebookWebhookVerifiedAt == null || data.facebookWebhookVerifiedAt is timestamp) &&
        (!('facebookConnectedAt' in data) || data.facebookConnectedAt == null || data.facebookConnectedAt is timestamp) &&
        (!('messengerUtilityEnabledTemplates' in data) || (data.messengerUtilityEnabledTemplates is list && data.messengerUtilityEnabledTemplates.size() <= 6)) &&
        (!('messengerUtilityUpdatedAt' in data) || data.messengerUtilityUpdatedAt == null || data.messengerUtilityUpdatedAt is timestamp) &&
        data.driveFolderId is string && data.driveFolderId.size() <= 200 &&
        data.webhookUrl is string && data.webhookUrl.size() <= 500;
    }

    function validPaymentSettings(data) {
      return data.keys().hasOnly(['bankBin', 'bankName', 'accountNumber', 'accountName', 'contentTemplate', 'vietQrTemplate', 'updatedAt']) &&
        data.keys().hasAll(['bankBin', 'bankName', 'accountNumber', 'accountName', 'contentTemplate', 'vietQrTemplate', 'updatedAt']) &&
        data.bankBin is string && data.bankBin.matches('^[0-9]{6}$') &&
        data.bankName is string && data.bankName.size() <= 100 &&
        data.accountNumber is string && data.accountNumber.matches('^[A-Za-z0-9]{6,19}$') &&
        data.accountName is string && data.accountName.size() >= 5 && data.accountName.size() <= 50 &&
        data.contentTemplate is string && data.contentTemplate.size() <= 50 &&
        data.vietQrTemplate is string && data.vietQrTemplate.size() >= 2 && data.vietQrTemplate.size() <= 60;
    }

    function validAcademicSettings(data) {
      return data.keys().hasOnly(['rankThresholds', 'updatedAt']) &&
        data.keys().hasAll(['rankThresholds', 'updatedAt']) &&
        data.updatedAt is timestamp &&
        data.rankThresholds.keys().hasOnly(['S', 'A', 'B', 'D']) &&
        data.rankThresholds.keys().hasAll(['S', 'A', 'B', 'D']) &&
        data.rankThresholds.S is number && data.rankThresholds.S <= 100 &&
        data.rankThresholds.S > data.rankThresholds.A &&
        data.rankThresholds.A > data.rankThresholds.B &&
        data.rankThresholds.B > data.rankThresholds.D &&
        data.rankThresholds.D == 0;
    }

    function isAssignedTeacherForClass(classId) {
      return isTeacher() &&
        exists(/databases/$(database)/documents/classes/$(classId)) &&
        request.auth.uid in get(/databases/$(database)/documents/classes/$(classId)).data.teacherIds;
    }

    function canManageClass(classId) {
      return isAdmin() || isAssignedTeacherForClass(classId);
    }

    function classIsSchedulable(classId) {
      return existsAfter(/databases/$(database)/documents/classes/$(classId)) &&
        getAfter(/databases/$(database)/documents/classes/$(classId)).data.get('status', 'active') == 'active' &&
        existsAfter(/databases/$(database)/documents/courses/$(getAfter(/databases/$(database)/documents/classes/$(classId)).data.courseId)) &&
        getAfter(/databases/$(database)/documents/courses/$(getAfter(/databases/$(database)/documents/classes/$(classId)).data.courseId)).data.status == 'active';
    }

    function isAssignedTeacherForCourse(courseId) {
      return isTeacher() &&
        exists(/databases/$(database)/documents/courses/$(courseId)) &&
        request.auth.uid in get(/databases/$(database)/documents/courses/$(courseId)).data.teacherIds;
    }

    function sessionBelongsToClass(sessionId, classId) {
      return exists(/databases/$(database)/documents/sessions/$(sessionId)) &&
        get(/databases/$(database)/documents/sessions/$(sessionId)).data.classId == classId;
    }

    function validSessionInteraction(data, sessionId) {
      return data.keys().hasOnly([
          'sessionId', 'classId', 'courseId', 'teacherId', 'workflowStatus',
          'taughtContent', 'quickSummary', 'homeworkText', 'version', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasAll([
          'sessionId', 'classId', 'courseId', 'teacherId', 'workflowStatus',
          'taughtContent', 'quickSummary', 'homeworkText', 'version', 'createdAt', 'updatedAt'
        ]) &&
        data.sessionId == sessionId &&
        data.workflowStatus == 'draft' && data.version == 1 &&
        data.taughtContent is string && data.taughtContent.size() <= 2000 &&
        data.quickSummary is string && data.quickSummary.size() <= 2000 &&
        data.homeworkText is string && data.homeworkText.size() <= 2000 &&
        data.teacherId is string && (data.teacherId == request.auth.uid || isAdmin()) &&
        data.createdAt is timestamp && data.updatedAt is timestamp &&
        sessionBelongsToClass(sessionId, data.classId) &&
        get(/databases/$(database)/documents/classes/$(data.classId)).data.courseId == data.courseId;
    }

    function validSessionStudentReview(data, reviewId) {
      return data.keys().hasOnly([
          'sessionId', 'classId', 'studentId', 'attendanceStatus',
          'previousHomeworkStatus', 'individualComment', 'updatedBy', 'updatedAt'
        ]) &&
        data.keys().hasAll([
          'sessionId', 'classId', 'studentId', 'attendanceStatus',
          'previousHomeworkStatus', 'individualComment', 'updatedBy', 'updatedAt'
        ]) &&
        reviewId == data.sessionId + '_' + data.studentId &&
        data.attendanceStatus in ['present', 'absent', 'late', 'excused'] &&
        data.previousHomeworkStatus in ['done', 'partial', 'not_done', 'not_assigned'] &&
        data.individualComment is string && data.individualComment.size() <= 1000 &&
        data.updatedBy == request.auth.uid && data.updatedAt is timestamp &&
        sessionBelongsToClass(data.sessionId, data.classId) &&
        data.studentId in get(/databases/$(database)/documents/classes/$(data.classId)).data.studentIds;
    }

    function keepsImmutable(fieldNames) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fieldNames);
    }

    function courseHasClassRevision(courseId) {
      return get(/databases/$(database)/documents/courses/$(courseId)).data.keys().hasAny(['classRevision']);
    }

    function advancesCourseClassRevision(courseId) {
      return !courseHasClassRevision(courseId) ||
        getAfter(/databases/$(database)/documents/courses/$(courseId)).data.classRevision ==
          get(/databases/$(database)/documents/courses/$(courseId)).data.classRevision + 1;
    }

    function validCourseClassRevisionUpdate() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['classRevision']) || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['classRevision']) &&
        request.resource.data.classRevision ==
          (resource.data.keys().hasAny(['classRevision']) ? resource.data.classRevision : 0) + 1
      );
    }

    function isTeacherCurriculumPointerUpdate(courseId) {
      return isAssignedTeacherForCourse(courseId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'activeCurriculumId', 'activeCurriculumVersion',
          'curriculumVersionCounter', 'updatedAt'
        ]);
    }

    function ownsStudent(studentId) {
      return isActive() &&
        currentUser().role == 'viewer' &&
        studentId in currentUser().studentIds;
    }

    function isAssignedTeacherForStudent(studentId) {
      return isTeacher() &&
        exists(/databases/$(database)/documents/students/$(studentId)) &&
        request.auth.uid in get(/databases/$(database)/documents/students/$(studentId)).data.teacherIds;
    }

    function isTeacherEnrollmentClassUpdate() {
      let addedStudentIds = request.resource.data.studentIds.removeAll(resource.data.studentIds);
      return isTeacher() && request.auth.uid in resource.data.teacherIds &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentIds', 'updatedAt']) &&
        request.resource.data.teacherIds == resource.data.teacherIds &&
        request.resource.data.studentIds.hasAll(resource.data.studentIds) &&
        request.resource.data.studentIds.size() == resource.data.studentIds.size() + 1 &&
        addedStudentIds.size() == 1;
    }

    function isTeacherUnenrollmentClassUpdate() {
      let removedStudentIds = resource.data.studentIds.removeAll(request.resource.data.studentIds);
      return isTeacher() && request.auth.uid in resource.data.teacherIds &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentIds', 'updatedAt']) &&
        request.resource.data.teacherIds == resource.data.teacherIds &&
        resource.data.studentIds.hasAll(request.resource.data.studentIds) &&
        request.resource.data.studentIds.size() == resource.data.studentIds.size() - 1 &&
        removedStudentIds.size() == 1;
    }

    function isTeacherEnrollmentStudentUpdate() {
      let addedClassIds = request.resource.data.currentClassIds.removeAll(resource.data.currentClassIds);
      let classData = get(/databases/$(database)/documents/classes/$(addedClassIds[0])).data;
      return isTeacher() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentClassIds', 'teacherIds', 'updatedAt']) &&
        request.resource.data.currentClassIds.hasAll(resource.data.currentClassIds) &&
        request.resource.data.currentClassIds.size() == resource.data.currentClassIds.size() + 1 &&
        addedClassIds.size() == 1 &&
        request.auth.uid in classData.teacherIds &&
        request.resource.data.teacherIds.hasAll(resource.data.teacherIds) &&
        request.resource.data.teacherIds.hasAll(classData.teacherIds) &&
        request.resource.data.teacherIds.removeAll(resource.data.teacherIds).hasOnly(classData.teacherIds);
    }

    function isTeacherUnenrollmentStudentUpdate() {
      let removedClassIds = resource.data.currentClassIds.removeAll(request.resource.data.currentClassIds);
      let classData = get(/databases/$(database)/documents/classes/$(removedClassIds[0])).data;
      return isTeacher() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentClassIds', 'teacherIds', 'updatedAt']) &&
        resource.data.currentClassIds.hasAll(request.resource.data.currentClassIds) &&
        request.resource.data.currentClassIds.size() == resource.data.currentClassIds.size() - 1 &&
        removedClassIds.size() == 1 &&
        request.auth.uid in classData.teacherIds &&
        resource.data.teacherIds.removeAll(request.resource.data.teacherIds).hasOnly(classData.teacherIds);
    }

    function isTeacherEnrollmentCreate(enrollmentId) {
      let classId = request.resource.data.classId;
      let studentId = request.resource.data.studentId;
      let classData = get(/databases/$(database)/documents/classes/$(classId)).data;
      return isTeacher() && request.auth.uid in classData.teacherIds &&
        enrollmentId == classId + '_' + studentId &&
        request.resource.data.status == 'active' &&
        request.resource.data.courseId == classData.courseId;
    }

    // ---------- Invite claim helpers (A16.4) ----------
    // Email phai ton tai va da duoc Google xac minh - khong tin email chua verify.

    function hasVerifiedEmail() {
      return signedIn() &&
        request.auth.token.email != null &&
        request.auth.token.email_verified == true;
    }

    function requesterEmail() {
      return request.auth.token.email.lower();
    }

    function inviteForRequester() {
      return get(/databases/$(database)/documents/invites/$(requesterEmail())).data;
    }

    function hasActiveInvite() {
      return hasVerifiedEmail() &&
        exists(/databases/$(database)/documents/invites/$(requesterEmail())) &&
        inviteForRequester().status == 'active';
    }

    function isValidRole(role) {
      return role in ['admin', 'teacher', 'viewer'];
    }

    function hasTimestamps(data) {
      return data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function isStringList(value) {
      return value is list;
    }

    function validUserData(data) {
      return data.keys().hasAll(['role', 'studentIds', 'status']) &&
        data.keys().hasOnly(['email', 'displayName', 'photoURL', 'role', 'studentIds', 'status', 'createdAt', 'updatedAt', 'lastLoginAt', 'notificationPrefs', 'phone', 'address', 'facebookUrl']) &&
        isValidRole(data.role) &&
        data.studentIds is list &&
        (data.role == 'viewer' || data.studentIds.size() == 0) &&
        data.status in ['active', 'disabled'] &&
        (!data.keys().hasAny(['email']) || (
          data.email is string &&
          data.email.matches('^[^@ ]+@[^@ ]+\\.[A-Za-z]{2,}$')
        )) &&
        (!data.keys().hasAny(['displayName']) || data.displayName is string) &&
        (!data.keys().hasAny(['photoURL']) || data.photoURL == null || data.photoURL is string) &&
        (!data.keys().hasAny(['phone']) || data.phone is string) &&
        (!data.keys().hasAny(['address']) || data.address is string) &&
        (!data.keys().hasAny(['facebookUrl']) || data.facebookUrl is string) &&
        (!data.keys().hasAny(['createdAt']) || data.createdAt is timestamp) &&
        (!data.keys().hasAny(['updatedAt']) || data.updatedAt is timestamp) &&
        (!data.keys().hasAny(['lastLoginAt']) || data.lastLoginAt is timestamp) &&
        (!data.keys().hasAny(['notificationPrefs']) || data.notificationPrefs is map);
    }

    function validInviteData(email, data) {
      return data.keys().hasAll(['email', 'role', 'studentIds', 'status', 'createdBy', 'createdAt']) &&
        data.keys().hasOnly(['email', 'role', 'studentIds', 'status', 'createdBy', 'createdAt', 'claimedAt']) &&
        data.email == email &&
        data.email is string &&
        data.email.matches('^[^@ ]+@[^@ ]+\\.[A-Za-z]{2,}$') &&
        isValidRole(data.role) &&
        data.studentIds is list &&
        (data.role == 'viewer' || data.studentIds.size() == 0) &&
        data.status in ['active', 'claimed', 'revoked'] &&
        data.createdBy is string &&
        data.createdAt is timestamp &&
        (!data.keys().hasAny(['claimedAt']) || data.claimedAt is timestamp);
    }

    function validSubjectData(subjectId, data) {
      return data.keys().hasAll(['name', 'code', 'description', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['name', 'code', 'description', 'status', 'createdAt', 'updatedAt']) &&
        data.name is string &&
        data.code == subjectId &&
        data.description is string &&
        data.status in ['active', 'archived'] &&
        hasTimestamps(data);
    }

    function validCoursePointer(courseId, data) {
      let curriculumId = data.get('activeCurriculumId', null);
      let curriculumVersion = data.get('activeCurriculumVersion', null);
      return (curriculumId == null && curriculumVersion == null) || (
        curriculumId is string && curriculumVersion is int &&
        existsAfter(/databases/$(database)/documents/course_curricula/$(curriculumId)) &&
        getAfter(/databases/$(database)/documents/course_curricula/$(curriculumId)).data.courseId == courseId &&
        getAfter(/databases/$(database)/documents/course_curricula/$(curriculumId)).data.version == curriculumVersion &&
        getAfter(/databases/$(database)/documents/course_curricula/$(curriculumId)).data.status == 'published' &&
        data.get('curriculumVersionCounter', curriculumVersion) >= curriculumVersion
      );
    }

    function validCourseData(courseId, data) {
      return data.keys().hasAll(['name', 'subjectIds', 'pricePerSession', 'tuitionFee', 'totalSessions', 'startDate', 'endDate', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['name', 'subjectIds', 'teacherIds', 'pricePerSession', 'tuitionFee', 'totalSessions', 'startDate', 'endDate', 'status', 'activeCurriculumId', 'activeCurriculumVersion', 'curriculumVersionCounter', 'classRevision', 'createdAt', 'updatedAt']) &&
        data.name is string &&
        isStringList(data.subjectIds) &&
        data.subjectIds.size() > 0 &&
        (!data.keys().hasAny(['teacherIds']) || isStringList(data.teacherIds)) &&
        data.pricePerSession is int &&
        data.pricePerSession >= 0 &&
        data.tuitionFee is int &&
        data.tuitionFee >= 0 &&
        data.totalSessions is int &&
        data.totalSessions > 0 &&
        data.startDate is timestamp &&
        data.endDate is timestamp &&
        data.endDate >= data.startDate &&
        data.status in ['draft', 'active', 'completed'] &&
        (!data.keys().hasAny(['activeCurriculumId']) || data.activeCurriculumId == null || data.activeCurriculumId is string) &&
        (!data.keys().hasAny(['activeCurriculumVersion']) || data.activeCurriculumVersion == null || data.activeCurriculumVersion is int) &&
        (!data.keys().hasAny(['curriculumVersionCounter']) || data.curriculumVersionCounter == null || (data.curriculumVersionCounter is int && data.curriculumVersionCounter >= 0)) &&
        (!data.keys().hasAny(['classRevision']) || (data.classRevision is int && data.classRevision >= 0)) &&
        validCoursePointer(courseId, data) &&
        hasTimestamps(data);
    }

    function validBillingItemData(data) {
      return data.keys().hasAll(['name', 'courseId', 'subjectId', 'unitPrice', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['name', 'courseId', 'subjectId', 'unitPrice', 'status', 'createdAt', 'updatedAt']) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 160 &&
        data.courseId is string && data.subjectId is string &&
        data.unitPrice is int && data.unitPrice > 0 &&
        data.status in ['active', 'archived'] &&
        hasTimestamps(data) &&
        exists(/databases/$(database)/documents/courses/$(data.courseId)) &&
        exists(/databases/$(database)/documents/subjects/$(data.subjectId)) &&
        data.subjectId in get(/databases/$(database)/documents/courses/$(data.courseId)).data.subjectIds;
    }

    function validStudentData(studentId, data) {
      return data.keys().hasAll(['studentCode', 'fullName', 'dateOfBirth', 'parentUids', 'currentClassIds', 'teacherIds', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['studentCode', 'fullName', 'nickname', 'dateOfBirth', 'parentUids', 'currentClassIds', 'teacherIds', 'staffNote', 'status', 'createdAt', 'updatedAt']) &&
        data.studentCode == studentId &&
        data.fullName is string &&
        data.dateOfBirth is string &&
        isStringList(data.parentUids) &&
        isStringList(data.currentClassIds) &&
        isStringList(data.teacherIds) &&
        (!data.keys().hasAny(['staffNote']) || data.staffNote is string) &&
        (!data.keys().hasAny(['nickname']) || data.nickname is string) &&
        data.status in ['active', 'inactive'] &&
        (data.status == 'active' || (data.currentClassIds.size() == 0 && data.teacherIds.size() == 0)) &&
        hasTimestamps(data);
    }

    function validRecurrence(data) {
      return data.keys().hasAll(['daysOfWeek', 'startTime', 'endTime', 'startDate', 'endDate', 'sessionCount']) &&
        data.keys().hasOnly(['daysOfWeek', 'startTime', 'endTime', 'startDate', 'endDate', 'sessionCount']) &&
        data.daysOfWeek is list &&
        data.daysOfWeek.size() > 0 && data.daysOfWeek.hasOnly([0, 1, 2, 3, 4, 5, 6]) &&
        data.startTime is string &&
        data.endTime is string &&
        data.startDate is timestamp &&
        data.endDate is timestamp &&
        data.endDate >= data.startDate &&
        data.sessionCount is int &&
        data.sessionCount > 0 && data.sessionCount <= 200;
    }

    function validClassData(data) {
      return data.keys().hasAll(['name', 'courseId', 'subjectIds', 'teacherIds', 'studentIds', 'scheduleText', 'location', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['name', 'courseId', 'subjectIds', 'teacherIds', 'studentIds', 'scheduleText', 'location', 'status', 'curriculumId', 'curriculumVersion', 'recurrence', 'createdAt', 'updatedAt']) &&
        data.name is string &&
        data.courseId is string &&
        isStringList(data.subjectIds) &&
        data.subjectIds.size() > 0 &&
        data.subjectIds.toSet().size() == data.subjectIds.size() &&
        isStringList(data.teacherIds) &&
        data.teacherIds.toSet().size() == data.teacherIds.size() &&
        isStringList(data.studentIds) &&
        data.studentIds.toSet().size() == data.studentIds.size() &&
        data.scheduleText is string &&
        data.location is string &&
        data.status in ['active', 'completed', 'cancelled'] &&
        (!data.keys().hasAny(['curriculumId']) || data.curriculumId == null || data.curriculumId is string) &&
        (!data.keys().hasAny(['curriculumVersion']) || data.curriculumVersion == null || data.curriculumVersion is int) &&
        (!data.keys().hasAny(['recurrence']) || data.recurrence == null || validRecurrence(data.recurrence)) &&
        hasTimestamps(data);
    }

    function validSessionData(data) {
      return data.keys().hasAll(['classId', 'title', 'startAt', 'endAt', 'location', 'status', 'note', 'makeUpForSessionId', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['classId', 'title', 'startAt', 'endAt', 'location', 'status', 'note', 'makeUpForSessionId', 'sequenceNumber', 'curriculumVersion', 'curriculumItemId', 'lessonPlanId', 'scheduleVersion', 'createdAt', 'updatedAt']) &&
        data.classId is string &&
        data.title is string &&
        data.startAt is timestamp &&
        data.endAt is timestamp &&
        data.endAt >= data.startAt &&
        data.location is string &&
        data.status in ['scheduled', 'rescheduled', 'cancelled', 'completed'] &&
        data.note is string &&
        (data.makeUpForSessionId == null || data.makeUpForSessionId is string) &&
        (!data.keys().hasAny(['sequenceNumber']) || data.sequenceNumber == null || data.sequenceNumber is int) &&
        (!data.keys().hasAny(['scheduleVersion']) || (data.scheduleVersion is int && data.scheduleVersion >= 0)) &&
        (!data.keys().hasAny(['curriculumVersion']) || data.curriculumVersion == null || data.curriculumVersion is int) &&
        (!data.keys().hasAny(['curriculumItemId']) || data.curriculumItemId == null || data.curriculumItemId is string) &&
        (!data.keys().hasAny(['lessonPlanId']) || data.lessonPlanId == null || data.lessonPlanId is string) &&
        hasTimestamps(data);
    }

    function validLessonPlanObjectives(data) {
      return data.keys().hasAll(['knowledge', 'skills', 'attitude']) &&
        data.keys().hasOnly(['knowledge', 'skills', 'attitude']) &&
        data.knowledge is string &&
        data.skills is string &&
        data.attitude is string;
    }

    function validLessonPlanPreparation(data) {
      return data.keys().hasAll(['teacher', 'student']) &&
        data.keys().hasOnly(['teacher', 'student']) &&
        data.teacher is string &&
        data.student is string;
    }

    function validLessonPlanDriveAttachment(data) {
      return (
        data.get('driveFileId', null) == null &&
        data.get('driveFileName', null) == null &&
        data.get('driveMimeType', null) == null &&
        data.get('driveWebViewLink', null) == null &&
        data.get('driveModifiedTime', null) == null
      ) || (
        data.driveFileId is string && data.driveFileId.size() <= 200 &&
        data.driveFileName is string && data.driveFileName.size() <= 300 &&
        data.driveMimeType is string && data.driveMimeType.size() <= 150 &&
        data.driveWebViewLink is string && data.driveWebViewLink.matches('https://.*') &&
        data.driveModifiedTime is string && data.driveModifiedTime.size() <= 50
      );
    }

    function validLessonPlanData(data) {
      return data.keys().hasAll(['title', 'classId', 'courseId', 'subjectId', 'sessionId', 'objectives', 'preparation', 'activities', 'homework', 'notesAfterTeaching', 'attachmentUrl', 'attachmentLabel', 'publicSummary', 'status', 'createdBy', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['title', 'classId', 'courseId', 'subjectId', 'sessionId', 'objectives', 'preparation', 'activities', 'homework', 'notesAfterTeaching', 'attachmentUrl', 'attachmentLabel', 'driveFileId', 'driveFileName', 'driveMimeType', 'driveWebViewLink', 'driveModifiedTime', 'publicSummary', 'status', 'sourceStandardLessonId', 'curriculumItemId', 'readinessStatus', 'createdBy', 'createdAt', 'updatedAt']) &&
        data.title is string &&

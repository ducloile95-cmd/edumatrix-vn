    function validEnrollmentData(enrollmentId, data) {
      return data.keys().hasAll(['classId', 'courseId', 'studentId', 'status', 'joinedAt', 'endedAt', 'version', 'updatedAt']) &&
        data.keys().hasOnly(['classId', 'courseId', 'studentId', 'status', 'joinedAt', 'endedAt', 'version', 'updatedAt']) &&
        data.classId is string && data.courseId is string && data.studentId is string &&

          ) || (
            data.type == 'homework_reminder' &&
            announcementId == 'assignment_' + data.assignmentId + '_' + data.studentId &&
            get(/databases/$(database)/documents/assignments/$(data.assignmentId)).data.classId == data.classId
          ) || (
            data.type == 'session_summary' &&
            announcementId == data.sessionId + '_' + data.studentId &&

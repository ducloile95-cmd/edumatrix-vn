    function validStandardLessonTransition() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let creatorCanSubmit = resource.data.createdBy == request.auth.uid && resource.data.approvalStatus == 'draft' &&
        request.resource.data.approvalStatus == 'pending' && changed.hasOnly(['approvalStatus', 'updatedAt']);
      let canEditDraft = resource.data.approvalStatus == 'draft' && request.resource.data.approvalStatus == 'draft' &&
        request.resource.data.revision == resource.data.revision + 1 &&
        (isAdmin() || resource.data.createdBy == request.auth.uid);
      let adminTransition = isAdmin() && changed.hasOnly(['approvalStatus', 'updatedAt']) &&
        request.resource.data.revision == resource.data.revision && (
          (resource.data.approvalStatus == 'pending' && request.resource.data.approvalStatus in ['approved', 'draft']) ||
          (resource.data.approvalStatus == 'approved' && request.resource.data.approvalStatus == 'archived')
        );
      return creatorCanSubmit || canEditDraft || adminTransition;
    }

    function validCurriculumStandardLesson(data) {

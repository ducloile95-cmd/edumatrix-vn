    function validMessengerDeliveryEvent(eventId, data) {
      return data.keys().hasAll([
          'eventType', 'entityId', 'sourceId', 'studentId', 'version', 'actorUid',
          'idempotencyKey', 'status', 'attempts', 'lastErrorCode', 'leaseUntil',
          'nextAttemptAt', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'eventType', 'entityId', 'sourceId', 'studentId', 'version', 'actorUid',
          'idempotencyKey', 'status', 'attempts', 'lastErrorCode', 'leaseUntil',
          'nextAttemptAt', 'createdAt', 'updatedAt'
        ]) &&
        data.eventType in ['lesson_feedback_published', 'invoice_committed', 'payment_verified', 'enrollment_completed', 'session_schedule_changed'] &&
        data.entityId is string && data.sourceId is string && data.studentId is string &&
        data.version is int && data.version >= 1 &&
        data.actorUid == request.auth.uid && data.idempotencyKey == eventId &&
        data.status == 'pending' && data.attempts == 0 &&
        data.lastErrorCode == null && data.leaseUntil == null &&
        data.nextAttemptAt == request.time && data.createdAt == request.time && data.updatedAt == request.time &&
        (
          (
            data.eventType == 'session_schedule_changed' &&
            data.entityId == 'schedule_' + data.sourceId + '_' + data.studentId &&
            existsAfter(/databases/$(database)/documents/sessions/$(data.sourceId)) &&
            getAfter(/databases/$(database)/documents/sessions/$(data.sourceId)).data.status in ['rescheduled', 'cancelled'] &&
            getAfter(/databases/$(database)/documents/sessions/$(data.sourceId)).data.get('scheduleVersion', 0) == data.version &&
            existsAfter(/databases/$(database)/documents/classes/$(getAfter(/databases/$(database)/documents/sessions/$(data.sourceId)).data.classId)) &&
            getAfter(/databases/$(database)/documents/classes/$(getAfter(/databases/$(database)/documents/sessions/$(data.sourceId)).data.classId)).data.studentIds.hasAny([data.studentId])
          ) ||
          (
            data.eventType == 'lesson_feedback_published' &&
            data.entityId == data.sourceId + '_' + data.studentId &&
            existsAfter(/databases/$(database)/documents/announcements/$(data.entityId)) &&
            getAfter(/databases/$(database)/documents/announcements/$(data.entityId)).data.type == 'session_summary' &&
            getAfter(/databases/$(database)/documents/announcements/$(data.entityId)).data.studentId == data.studentId &&
            existsAfter(/databases/$(database)/documents/session_interactions/$(data.sourceId)) &&
            getAfter(/databases/$(database)/documents/session_interactions/$(data.sourceId)).data.workflowStatus == 'published' &&
            getAfter(/databases/$(database)/documents/session_interactions/$(data.sourceId)).data.version == data.version
          ) ||
          (
            data.eventType == 'invoice_committed' && data.entityId == data.sourceId && data.version == 1 &&
            existsAfter(/databases/$(database)/documents/invoices/$(data.entityId)) &&
            getAfter(/databases/$(database)/documents/invoices/$(data.entityId)).data.studentId == data.studentId &&
            getAfter(/databases/$(database)/documents/invoices/$(data.entityId)).data.status == 'unpaid'
          ) ||
          (
            data.eventType == 'payment_verified' && data.entityId == data.sourceId && data.version == 1 &&
            existsAfter(/databases/$(database)/documents/payments/$(data.entityId)) &&
            getAfter(/databases/$(database)/documents/payments/$(data.entityId)).data.studentId == data.studentId &&
            getAfter(/databases/$(database)/documents/payments/$(data.entityId)).data.status == 'verified'
          ) ||
          (
            data.eventType == 'enrollment_completed' && data.entityId == data.sourceId &&
            existsAfter(/databases/$(database)/documents/enrollments/$(data.entityId)) &&
            getAfter(/databases/$(database)/documents/enrollments/$(data.entityId)).data.studentId == data.studentId &&
            getAfter(/databases/$(database)/documents/enrollments/$(data.entityId)).data.status == 'active' &&
            getAfter(/databases/$(database)/documents/enrollments/$(data.entityId)).data.version == data.version
          )
        );
    }

    function validCurriculumTransition() {
      return (resource.data.status == 'draft' && request.resource.data.status in ['draft', 'published']) ||
        (resource.data.status == 'published' && request.resource.data.status == 'superseded') ||
        (resource.data.status in ['superseded', 'archived'] && request.resource.data.status == resource.data.status);
    }

    function validCurriculumCourseState(curriculumId, data) {
      let course = getAfter(/databases/$(database)/documents/courses/$(data.courseId)).data;
      let activeVersion = course.get('activeCurriculumVersion', 0);
      return existsAfter(/databases/$(database)/documents/courses/$(data.courseId)) &&
        data.itemCount == course.totalSessions &&
        data.version <= course.get('curriculumVersionCounter', 0) &&
        (
          (data.status == 'draft' && (activeVersion == null || data.version > activeVersion)) ||
          (data.status == 'published' && course.activeCurriculumId == curriculumId && course.activeCurriculumVersion == data.version) ||
          (data.status in ['superseded', 'archived'] && course.get('activeCurriculumId', null) != curriculumId)
        );
    }

    function curriculumItemVersionIsEditable(data) {
      let course = getAfter(/databases/$(database)/documents/courses/$(data.courseId)).data;
      let activeVersion = course.get('activeCurriculumVersion', 0);
      return existsAfter(/databases/$(database)/documents/courses/$(data.courseId)) &&
        data.curriculumVersion <= course.get('curriculumVersionCounter', 0) &&
        (activeVersion == null || data.curriculumVersion > activeVersion);
    }

    function validScoreSource(data, scoreId) {
      return data.get('source', 'manual') in ['manual', 'assignment'] &&
        (
          (
            data.get('source', 'manual') == 'manual' &&
            data.get('assignmentId', null) == null &&
            data.get('submissionId', null) == null
          ) || (
            data.get('source', 'manual') == 'assignment' &&
            data.assessmentType == 'assignment' &&
            scoreId == 'assignment_' + data.assignmentId + '_' + data.studentId &&
            get(/databases/$(database)/documents/assignments/$(data.assignmentId)).data.classId == data.classId &&
            get(/databases/$(database)/documents/assignments/$(data.assignmentId)).data.get('subjectId', '') == data.subjectId &&
            get(/databases/$(database)/documents/assignments/$(data.assignmentId)).data.title == data.assessmentName &&
            get(/databases/$(database)/documents/assignments/$(data.assignmentId)).data.maxScore == data.maxScore &&
            get(/databases/$(database)/documents/submissions/$(data.submissionId)).data.studentId == data.studentId &&
            get(/databases/$(database)/documents/submissions/$(data.submissionId)).data.assignmentId == data.assignmentId &&
            get(/databases/$(database)/documents/submissions/$(data.submissionId)).data.classId == data.classId
          )
        );
    }

    function validAssignmentData(data) {
      return data.keys().hasAll(['title', 'description', 'classId', 'lessonPlanId', 'sessionId', 'dueAt', 'submissionType', 'maxScore', 'status', 'createdBy', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['title', 'description', 'classId', 'subjectId', 'lessonPlanId', 'sessionId', 'dueAt', 'submissionType', 'maxScore', 'status', 'createdBy', 'createdAt', 'updatedAt']) &&
        data.title is string &&

    function lessonPlanLinksBelongTogether(data) {
      return data.classId is string &&
        exists(/databases/$(database)/documents/classes/$(data.classId)) &&
        (data.courseId == null || data.courseId == get(/databases/$(database)/documents/classes/$(data.classId)).data.courseId) &&
        (data.subjectId == null || data.subjectId in get(/databases/$(database)/documents/classes/$(data.classId)).data.subjectIds) &&
        (data.sessionId == null || sessionBelongsToClass(data.sessionId, data.classId));

    function validCourseCurriculumData(curriculumId, data) {
      return data.keys().hasAll(['courseId', 'version', 'title', 'itemIds', 'itemCount', 'totalDurationMinutes', 'status', 'publishedBy', 'publishedAt', 'revision', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['courseId', 'version', 'title', 'itemIds', 'itemCount', 'totalDurationMinutes', 'status', 'publishedBy', 'publishedAt', 'revision', 'createdAt', 'updatedAt']) &&
